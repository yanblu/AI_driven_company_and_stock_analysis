# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Misc ──────────────────────────────────────────────────────────────────────
.cache/
guideline.txt
missfont.log

# ── Step 1: raw data (large PDFs, HTML, and free-API parquets) ────────────────
# Raw prices/macro are regenerated by collectors/prices.py and collectors/macro.py.
# Raw news HTML, transcripts PDFs, and IR report PDFs are re-downloaded by the
# collector scripts; too large to store in git (52 MB + 79 MB + 9.9 MB).
step1_data_collection/data/raw/

# ── Step 1: derived files to track ───────────────────────────────────────────
# data/chunks/*.jsonl  — tracked (needed as input for Step 2 annotation)
# data/manifest.csv    — tracked (provenance log)
# data/features/model_features_daily.parquet — tracked (Step 3 input)
*.jsonl.bak
*.jsonl.bak2

# ── Step 2: derived files to track ───────────────────────────────────────────
# data/llm_annotations/*.jsonl  — tracked (LLM cache; expensive to regenerate)
# data/features/nlp_features.parquet — tracked (quarterly NLP features for Step 3)
# data/features/finbert_comparison_transcripts.parquet — tracked (validation baseline)

# ── Parquets: ignore broadly; individual tracked files added via git add -f ───
*.parquet

# ── CSVs: ignore broadly; manifest is added via git add -f ───────────────────
*.csv

# ── Step 3: archive intermediate CSVs (not needed to reproduce final model) ───
step3_predictive_model/model_experiments_archive/redesign_single_stock/data/
step3_predictive_model/model_experiments_archive/archive_baseline_models/*.parquet
